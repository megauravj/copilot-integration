<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder package-path="com.megauravj.blog">
	<namespace>Blog</namespace>
	<entity name="BlogPost" local-service="true" remote-service="true" uuid="true">
		<!-- Primary Key -->
		<column name="postId" type="long" primary="true" />
		
		<!-- Foreign Keys and Multi-tenancy -->
		<column name="groupId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" db-name="user_name" />
		
		<!-- Content Fields -->
		<column name="title" type="String" required="true" db-name="title" max-length="255" />
		<column name="content" type="String" db-name="content" />
		
		<!-- Status Enum -->
		<column name="status" type="String" db-name="status" />
		
		<!-- Analytics -->
		<column name="viewCount" type="long" db-name="view_count" default-value="0" />
		
		<!-- Audit Fields -->
		<column name="createDate" type="Date" db-name="create_date" />
		<column name="modifiedDate" type="Date" db-name="modified_date" />
		
		<!-- Finder Methods -->
		<finder name="GroupId" return-type="Collection">
			<finder-column name="groupId" />
		</finder>
		<finder name="Status" return-type="Collection">
			<finder-column name="status" />
		</finder>
		<finder name="UserId" return-type="Collection">
			<finder-column name="userId" />
		</finder>
		<finder name="GroupIdAndStatus" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="status" />
		</finder>
	</entity>

	<entity name="BlogComment" local-service="true" remote-service="true" uuid="true">
		<!-- Primary Key -->
		<column name="commentId" type="long" primary="true" />
		
		<!-- Foreign Keys -->
		<column name="postId" type="long" db-name="post_id" />
		<column name="userId" type="long" />
		<column name="userName" type="String" db-name="user_name" />
		<column name="groupId" type="long" />
		
		<!-- Content -->
		<column name="commentText" type="String" db-name="comment_text" />
		
		<!-- Audit Fields -->
		<column name="createDate" type="Date" db-name="create_date" />
		<column name="modifiedDate" type="Date" db-name="modified_date" />
		
		<!-- Finder Methods -->
		<finder name="PostId" return-type="Collection">
			<finder-column name="postId" />
		</finder>
		<finder name="UserId" return-type="Collection">
			<finder-column name="userId" />
		</finder>
		<finder name="PostIdAndUserId" return-type="Collection">
			<finder-column name="postId" />
			<finder-column name="userId" />
		</finder>
	</entity>

	<exceptions>
		<exception>PortalException</exception>
		<exception>SystemException</exception>
		<exception>BlogPostException</exception>
		<exception>BlogCommentException</exception>
	</exceptions>
</service-builder>
